<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="20dp">

    <TextView
        android:id="@+id/tvQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Options injected dynamically via RadioGroup -->
    <RadioGroup
        android:id="@+id/radioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💡 Get Hint"
        android:textColor="#69F0AE"
        android:textSize="12sp"
        android:background="@drawable/btn_small_bg"
        android:padding="8dp"
        android:contentDescription="Get a hint for this question"
        android:layout_marginBottom="8dp"/>

    <!-- LLM hint box -->
    <LinearLayout
        android:id="@+id/llLlmBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/llm_box_bg"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvLlmPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#99FFFFFF"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp"/>

        <ProgressBar
            android:id="@+id/progressHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvLlmResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.5"/>
    </LinearLayout>

</LinearLayout>
